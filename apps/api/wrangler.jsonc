{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "luvo-api",
  "account_id": "9e844969d0c44b2449f3951d1f301654",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "preview_urls": false,
  "ai": { "binding": "AI", "remote": true },
  "vars": { "AI_GATEWAY_ID": "default" },
  "ratelimits": [{ "name": "AI_LIMITER", "namespace_id": "100701", "simple": { "limit": 5, "period": 60 } }, { "name": "BRIEF_LIMITER", "namespace_id": "100702", "simple": { "limit": 6, "period": 60 } }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luvo-db",
      "database_id": "9c242a60-4f60-4aee-a163-4a3afcc49b27",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "observability": { "enabled": true }
}
