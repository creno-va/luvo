---
import LuvoApp from '@/components/LuvoApp';
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '@/styles/global.css';
import '@/styles/dialog.css';
import '@/styles/landing-demo.css';

---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="처방전 한 장과 매일의 투약 체크. 우리 아이와 오래 함께하기 위한 작은 건강 기록, Luvo." />
    <meta name="theme-color" content="#f5f6f2" />
    <title>Luvo</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <LuvoApp client:only="react"><div slot="fallback" class="initial-loading">우리 아이의 기록을 준비하고 있어요…</div></LuvoApp>
    <noscript>투약 기록을 사용하려면 브라우저의 JavaScript를 켜주세요.</noscript>
  </body>
</html>
