---
const layers = [
  ['web', 'Astro · Cloudflare Workers'],
  ['api', 'Hono · Cloudflare Workers'],
  ['db', 'Drizzle · Cloudflare D1'],
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Luvo 웹 서비스" />
    <title>Luvo</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">luvo.baro.site</p>
      <h1>Luvo</h1>
      <p>웹 서비스의 시작점입니다.</p>
      <dl>
        {layers.map(([name, stack]) => <div><dt>{name}</dt><dd>{stack}</dd></div>)}
      </dl>
      <nav aria-label="상태 확인">
        <a href="/api/health">API 상태</a>
        <a href="/api/health/db">DB 연결 상태</a>
      </nav>
    </main>
  </body>
</html>

<style>
  :global(html) { font-family: system-ui, sans-serif; color: #1e293b; background: #f8fafc; }
  :global(body) { margin: 0; }
  main { max-width: 38rem; margin: 16vh auto; padding: 1.5rem; }
  .eyebrow { color: #64748b; font-size: 0.875rem; }
  h1 { margin: 0; font-size: clamp(3rem, 10vw, 5rem); letter-spacing: -0.05em; }
  dl { margin: 2.5rem 0; }
  dl div { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; padding: 1rem 0; border-bottom: 1px solid #e2e8f0; }
  dt { min-width: 2.5rem; font-weight: 600; }
  dd { margin: 0; color: #475569; }
  nav { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  a { color: #4338ca; text-underline-offset: 0.2em; }
</style>
