{
  "name": "@luvo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test src/lib/domain.test.ts src/lib/household.test.ts src/lib/health-record.test.ts src/lib/chat.test.ts src/lib/care-plan.test.ts src/lib/medication-list.test.ts",
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "check": "astro check && tsc --project tsconfig.worker.json",
    "cf:typegen": "npx wrangler types worker-configuration.d.ts --env-interface WebBindings",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "7.1.4",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "idb": "8.0.4",
    "lucide-react": "1.70.0",
    "pretendard": "1.3.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "6.2.7"
  }
}
